# ---- Bitcoin Cash ----
NEXT_PUBLIC_BCH_NETWORK=chipnet            # chipnet while building, mainnet for the demo
ORACLE_PRIVATE_KEY_HEX=                    # node scripts/gen-oracle-key.mjs  (server only, never commit)

# ---- Supabase (supabase.com → Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                 # server only

# ---- GitHub App (github.com/settings/apps/new) ----
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=                    # paste the .pem with \n for newlines
GITHUB_WEBHOOK_SECRET=

# ---- AI (aistudio.google.com/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash              # use the current Flash model listed in AI Studio

# ---- PatchProof NFT receipts (optional, stretch) ----
RECEIPT_WALLET_WIF=                        # server only; wallet that holds the minting NFT
RECEIPT_CATEGORY=                          # node scripts/create-receipt-category.mjs prints this

# ---- Site + BLAZE banner ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_REPO_URL=https://github.com/<you>/patchpay
NEXT_PUBLIC_BLAZE_DECK_URL=                # your copy of the Widget Factory template
NEXT_PUBLIC_EMBER_ADDRESS=                 # token-aware address (bitcoincash:z…) from Paytaca/Cashonize
